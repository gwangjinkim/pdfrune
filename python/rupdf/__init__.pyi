from os import PathLike
from typing import BinaryIO, Iterator, overload

__version__: str

def version() -> str: ...
def benchmark(pages: int = 50) -> dict[str, float | int]: ...

class Point:
    x: float
    y: float
    def __init__(self, x: float = 0.0, y: float = 0.0) -> None: ...
    def distance_to(self, other: Point) -> float: ...
    def __len__(self) -> int: ...
    def __getitem__(self, idx: int) -> float: ...
    def __iter__(self) -> Iterator[float]: ...

class Rect:
    x0: float
    y0: float
    x1: float
    y1: float
    @property
    def width(self) -> float: ...
    @property
    def height(self) -> float: ...
    @property
    def area(self) -> float: ...
    @property
    def is_empty(self) -> bool: ...
    def __init__(
        self, x0: float = 0.0, y0: float = 0.0, x1: float = 0.0, y1: float = 0.0
    ) -> None: ...
    def normalize(self) -> Rect: ...
    def contains(self, pt: Point) -> bool: ...
    def intersects(self, other: Rect) -> bool: ...
    def intersect(self, other: Rect) -> Rect: ...
    def union(self, other: Rect) -> Rect: ...
    def to_tuple(self) -> tuple[float, float, float, float]: ...
    def __len__(self) -> int: ...
    def __getitem__(self, idx: int) -> float: ...
    def __iter__(self) -> Iterator[float]: ...

class Matrix:
    a: float
    b: float
    c: float
    d: float
    e: float
    f: float
    def __init__(
        self,
        a: float = 1.0,
        b: float = 0.0,
        c: float = 0.0,
        d: float = 1.0,
        e: float = 0.0,
        f: float = 0.0,
    ) -> None: ...
    def multiply(self, other: Matrix) -> Matrix: ...
    def transform_point(self, pt: Point) -> Point: ...

class Table:
    @property
    def row_count(self) -> int: ...
    @property
    def col_count(self) -> int: ...
    @property
    def bbox(self) -> Rect: ...
    @property
    def header(self) -> list[str]: ...
    def extract(self) -> list[list[str]]: ...
    def to_markdown(self) -> str: ...
    def to_dicts(self) -> list[dict[str, str]]: ...

class Page:
    @property
    def number(self) -> int: ...
    @property
    def rect(self) -> Rect: ...
    @property
    def mediabox(self) -> Rect: ...
    @mediabox.setter
    def mediabox(self, rect: Rect) -> None: ...
    @property
    def cropbox(self) -> Rect: ...
    @cropbox.setter
    def cropbox(self, rect: Rect) -> None: ...
    @property
    def bleedbox(self) -> Rect: ...
    @property
    def trimbox(self) -> Rect: ...
    @property
    def artbox(self) -> Rect: ...
    @property
    def width(self) -> float: ...
    @property
    def height(self) -> float: ...
    @property
    def rotation(self) -> int: ...
    @rotation.setter
    def rotation(self, deg: int) -> None: ...
    def set_rotation(self, deg: int) -> None: ...
    def extract_text(self) -> str: ...
    def extract_words(
        self,
    ) -> list[tuple[float, float, float, float, str, int, int, int]]: ...
    def extract_blocks(
        self,
    ) -> list[tuple[float, float, float, float, str, int, int]]: ...
    def get_text(self, option: str = "text") -> str | list[tuple]: ...
    def search(self, needle: str) -> list[Rect]: ...
    def search_for(self, needle: str) -> list[Rect]: ...
    def insert_text(
        self,
        point: Point,
        text: str,
        fontsize: float = 12.0,
        color: tuple[float, float, float] = (0.0, 0.0, 0.0),
    ) -> None: ...
    def draw_rect(
        self,
        rect: Rect,
        color: tuple[float, float, float] | None = (0.0, 0.0, 0.0),
        fill: tuple[float, float, float] | None = None,
        width: float = 1.0,
    ) -> None: ...
    def render(self, dpi: float = 72.0) -> Pixmap: ...
    def get_pixmap(self, *, dpi: float = 72.0) -> Pixmap: ...
    def to_svg(self) -> str: ...
    def get_svg_image(self) -> str: ...
    def to_markdown(self) -> str: ...
    def to_html(self) -> str: ...
    def get_links(self) -> list[dict[str, object]]: ...
    def insert_link(self, link: dict[str, object]) -> None: ...
    def delete_link(self, link: dict[str, object]) -> None: ...
    def get_images(
        self,
    ) -> list[tuple[int, int, int, int, int, str, str, str, str]]: ...
    def insert_image(
        self,
        rect: Rect | tuple[float, float, float, float],
        *,
        filename: str | PathLike[str] | None = None,
        stream: bytes | bytearray | None = None,
        pixmap: Pixmap | None = None,
    ) -> int: ...
    def annots(self) -> list[dict[str, object]]: ...
    def add_highlight_annot(
        self, rect: Rect | tuple[float, float, float, float]
    ) -> dict[str, object]: ...
    def add_text_annot(self, point: Point, text: str) -> dict[str, object]: ...
    def add_rect_annot(
        self, rect: Rect | tuple[float, float, float, float]
    ) -> dict[str, object]: ...
    def delete_annot(self, annot: dict[str, object]) -> None: ...
    def add_redact_annot(
        self,
        rect: Rect | tuple[float, float, float, float],
        text: str | None = None,
        fill: tuple[float, float, float] = (0.0, 0.0, 0.0),
    ) -> dict[str, object]: ...
    def apply_redactions(self) -> int: ...
    def widgets(self) -> list[dict[str, object]]: ...
    def add_widget(self, widget: dict[str, object]) -> dict[str, object]: ...
    def set_field_value(self, field_name: str, value: str) -> bool: ...
    def find_tables(self) -> list[Table]: ...

class Pixmap:
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def n(self) -> int: ...
    @property
    def stride(self) -> int: ...
    @property
    def samples(self) -> bytes: ...
    def pixel(self, x: int, y: int) -> tuple[int, int, int, int]: ...
    def to_png(self) -> bytes: ...
    def tobytes(self, output: str = "png") -> bytes: ...
    def to_bytes(self, output: str = "png") -> bytes: ...
    def save_png(self, filename: str | PathLike[str]) -> None: ...
    def save(self, filename: str | PathLike[str]) -> None: ...

class Document:
    def __init__(
        self,
        filename: str | PathLike[str] | bytes | BinaryIO | None = None,
        *,
        stream: bytes | bytearray | BinaryIO | None = None,
        filetype: str | None = None,
    ) -> None: ...
    @property
    def page_count(self) -> int: ...
    @property
    def metadata(self) -> dict[str, str]: ...
    def set_metadata(self, metadata: dict[str, str]) -> None: ...
    @property
    def is_encrypted(self) -> bool: ...
    @property
    def needs_pass(self) -> bool: ...
    def authenticate(self, password: str) -> bool: ...
    @property
    def is_closed(self) -> bool: ...
    def load_page(self, page_id: int) -> Page: ...
    def new_page(
        self, pno: int = -1, width: float = 612.0, height: float = 792.0
    ) -> Page: ...
    def delete_page(self, pno: int) -> None: ...
    def select(self, page_indices: list[int]) -> None: ...
    def extract_pages(self, page_indices: list[int]) -> Document: ...
    def insert_pdf(
        self,
        other: Document,
        from_page: int = 0,
        to_page: int = -1,
        start_at: int = -1,
    ) -> None: ...
    def to_bytes(
        self,
        *,
        deflate: bool = False,
        encryption: str | None = None,
        user_pw: str | None = None,
        owner_pw: str | None = None,
    ) -> bytes: ...
    def write(
        self,
        *,
        deflate: bool = False,
        encryption: str | None = None,
        user_pw: str | None = None,
        owner_pw: str | None = None,
    ) -> bytes: ...
    def save(
        self,
        filename: str | PathLike[str],
        *,
        deflate: bool = False,
        encryption: str | None = None,
        user_pw: str | None = None,
        owner_pw: str | None = None,
    ) -> None: ...
    def to_markdown(self) -> str: ...
    def to_html(self) -> str: ...
    def to_rag_chunks(self, max_chars: int = 500) -> list[dict[str, object]]: ...
    def search_all(
        self, query: str, *, regex: bool = False
    ) -> list[tuple[int, list[Rect]]]: ...
    def get_toc(self) -> list[list[int | str]]: ...
    def set_toc(self, toc: list[list[int | str] | tuple[int, str, int]]) -> None: ...
    def extract_image(self, xref: int) -> dict[str, object]: ...
    def close(self) -> None: ...
    def __enter__(self) -> Document: ...
    def __exit__(self, exc_type: object, exc_val: object, exc_tb: object) -> bool: ...
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> Page: ...
    @overload
    def __getitem__(self, index: slice) -> list[Page]: ...
    def __iter__(self) -> Iterator[Page]: ...

def open(
    filename: str | PathLike[str] | bytes | BinaryIO | None = None,
    *,
    stream: bytes | bytearray | BinaryIO | None = None,
    filetype: str | None = None,
) -> Document: ...

def merge(documents: list[Document | str | PathLike[str]]) -> Document: ...

def batch_extract(
    inputs: list[Document | str | PathLike[str] | bytes],
) -> list[str]: ...

def batch_render(
    source: Document | str | PathLike[str] | bytes, *, dpi: float = 72.0
) -> list[Pixmap]: ...
