from os import PathLike
from typing import BinaryIO, Iterator, overload

__version__: str

def version() -> str: ...

class Point:
    x: float
    y: float
    def __init__(self, x: float = 0.0, y: float = 0.0) -> None: ...
    def distance_to(self, other: Point) -> float: ...
    def __len__(self) -> int: ...
    def __getitem__(self, idx: int) -> float: ...
    def __iter__(self) -> Iterator[float]: ...

class Rect:
    x0: float
    y0: float
    x1: float
    y1: float
    @property
    def width(self) -> float: ...
    @property
    def height(self) -> float: ...
    @property
    def area(self) -> float: ...
    @property
    def is_empty(self) -> bool: ...
    def __init__(
        self, x0: float = 0.0, y0: float = 0.0, x1: float = 0.0, y1: float = 0.0
    ) -> None: ...
    def normalize(self) -> Rect: ...
    def contains(self, pt: Point) -> bool: ...
    def intersects(self, other: Rect) -> bool: ...
    def intersect(self, other: Rect) -> Rect: ...
    def union(self, other: Rect) -> Rect: ...
    def to_tuple(self) -> tuple[float, float, float, float]: ...
    def __len__(self) -> int: ...
    def __getitem__(self, idx: int) -> float: ...
    def __iter__(self) -> Iterator[float]: ...

class Matrix:
    a: float
    b: float
    c: float
    d: float
    e: float
    f: float
    def __init__(
        self,
        a: float = 1.0,
        b: float = 0.0,
        c: float = 0.0,
        d: float = 1.0,
        e: float = 0.0,
        f: float = 0.0,
    ) -> None: ...
    def multiply(self, other: Matrix) -> Matrix: ...
    def transform_point(self, pt: Point) -> Point: ...

class Page:
    @property
    def number(self) -> int: ...
    @property
    def rect(self) -> Rect: ...
    @property
    def mediabox(self) -> Rect: ...
    @mediabox.setter
    def mediabox(self, rect: Rect) -> None: ...
    @property
    def cropbox(self) -> Rect: ...
    @cropbox.setter
    def cropbox(self, rect: Rect) -> None: ...
    @property
    def bleedbox(self) -> Rect: ...
    @property
    def trimbox(self) -> Rect: ...
    @property
    def artbox(self) -> Rect: ...
    @property
    def width(self) -> float: ...
    @property
    def height(self) -> float: ...
    @property
    def rotation(self) -> int: ...
    @rotation.setter
    def rotation(self, deg: int) -> None: ...
    def set_rotation(self, deg: int) -> None: ...
    def extract_text(self) -> str: ...
    def extract_words(
        self,
    ) -> list[tuple[float, float, float, float, str, int, int, int]]: ...
    def extract_blocks(
        self,
    ) -> list[tuple[float, float, float, float, str, int, int]]: ...
    def get_text(self, option: str = "text") -> str | list[tuple]: ...
    def search(self, needle: str) -> list[Rect]: ...
    def search_for(self, needle: str) -> list[Rect]: ...

class Document:
    def __init__(
        self,
        filename: str | PathLike[str] | bytes | BinaryIO | None = None,
        *,
        stream: bytes | bytearray | BinaryIO | None = None,
    ) -> None: ...
    @property
    def page_count(self) -> int: ...
    @property
    def metadata(self) -> dict[str, str]: ...
    def set_metadata(self, metadata: dict[str, str]) -> None: ...
    @property
    def is_encrypted(self) -> bool: ...
    @property
    def needs_pass(self) -> bool: ...
    def authenticate(self, password: str) -> bool: ...
    @property
    def is_closed(self) -> bool: ...
    def load_page(self, page_id: int) -> Page: ...
    def close(self) -> None: ...
    def __enter__(self) -> Document: ...
    def __exit__(self, exc_type: object, exc_val: object, exc_tb: object) -> bool: ...
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> Page: ...
    @overload
    def __getitem__(self, index: slice) -> list[Page]: ...
    def __iter__(self) -> Iterator[Page]: ...

def open(
    filename: str | PathLike[str] | bytes | BinaryIO | None = None,
    *,
    stream: bytes | bytearray | BinaryIO | None = None,
) -> Document: ...
