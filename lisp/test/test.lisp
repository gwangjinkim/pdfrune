(defpackage :cl-pdfrune-test
  (:use :cl :cl-pdfrune)
  (:export :run-all-tests))

(in-package :cl-pdfrune-test)

(defvar *test-count* 0
  "Total number of test assertions executed.")

(defvar *failed-count* 0
  "Number of failed test assertions.")

(defmacro check (form &optional description)
  "Evaluates FORM and increments *TEST-COUNT*. If FORM evaluates to NIL,
prints failure with DESCRIPTION and increments *FAILED-COUNT*."
  `(let ((result ,form))
     (incf *test-count*)
     (if result
         (format t "  [PASS] ~A~%" (or ,description ',form))
         (progn
           (incf *failed-count*)
           (format *error-output* "  [FAIL] ~A (evaluated to NIL)~%" (or ,description ',form))))))

(defmacro deftest (name &body body)
  "Defines a test function NAME with BODY."
  `(defun ,name ()
     (format t "~%=== Running ~A ===~%" ',name)
     ,@body))

(deftest test-version ()
  (check (stringp (version)) "Version returns a string")
  (check (string= (version) "0.1.0") "Version is 0.1.0"))

(deftest test-document-creation-and-lifecycle ()
  (let ((doc (new-pdf)))
    (check (pdf-document-p doc) "new-pdf returns a valid pdf-document")
    (check (= (page-count doc) 0) "Initial page-count is 0")
    (new-page doc :width 612.0 :height 792.0)
    (check (= (page-count doc) 1) "Page count is 1 after new-page")
    (let ((info (page-info doc 0)))
      (check (listp info) "page-info returns a plist")
      (check (= (getf info :width) 612.0) "Page width is 612.0")
      (check (= (getf info :height) 792.0) "Page height is 792.0"))
    (insert-text doc 0 '(72.0 72.0) "ANSI Common Lisp PDF Engine" :font-size 18.0)
    (let ((txt (extract-text doc 0)))
      (check (search "ANSI Common Lisp PDF Engine" txt) "Extracted text contains inserted string"))
    (close-pdf doc)
    (check (null (pdfrune::pdf-document-pointer doc)) "close-pdf nulls the internal pointer"))

  ;; with-open-pdf macro verification
  (let ((bytes (with-open-pdf (doc (new-pdf))
                 (new-page doc)
                 (insert-text doc 0 '(100.0 100.0) "With-Open-Pdf Macro Test")
                 (document-to-bytes doc :deflate t))))
    (check (typep bytes '(vector (unsigned-byte 8))) "document-to-bytes returns unsigned-byte 8 vector")
    (check (> (length bytes) 0) "Serialized bytes length > 0")
    (with-open-pdf (doc bytes)
      (check (= (page-count doc) 1) "Opened from bytes has 1 page")
      (check (search "With-Open-Pdf" (extract-text doc 0)) "Text matches in byte-opened doc"))))

(deftest test-words-blocks-search ()
  (with-open-pdf (doc (new-pdf))
    (new-page doc)
    (insert-text doc 0 '(72.0 100.0) "Common Lisp is expressive and powerful" :font-size 12.0)
    (let ((words (extract-words doc 0)))
      (check (listp words) "extract-words returns list")
      (check (some (lambda (w) (string= (getf w :word) "Lisp")) words) "extract-words found 'Lisp'"))
    (let ((blocks (extract-blocks doc 0)))
      (check (listp blocks) "extract-blocks returns list")
      (check (> (length blocks) 0) "extract-blocks returned at least one block"))
    (let ((rects (search-page doc 0 "expressive")))
      (check (> (length rects) 0) "search-page found bounding box for 'expressive'")
      (check (numberp (getf (first rects) :x0)) "Bounding box has numeric x0"))
    (let ((all-matches (search-document doc "expressive")))
      (check (> (length all-matches) 0) "search-document found match")
      (check (= (getf (first all-matches) :page) 0) "Match page index is 0"))))

(deftest test-table-detection ()
  (with-open-pdf (doc (new-pdf))
    (new-page doc)
    (insert-text doc 0 '(72.0 60.0) "Lisp Implementations Matrix" :font-size 16.0)
    (let ((y 120.0)
          (rows '(("Implementation" "Standard" "Platform")
                  ("SBCL" "ANSI" "Multi-arch")
                  ("CCL" "ANSI" "POSIX/Win")
                  ("ECL" "ANSI" "C-Embeddable"))))
      (dolist (r rows)
        (insert-text doc 0 (list 72.0 y) (first r) :font-size 11.0)
        (insert-text doc 0 (list 220.0 y) (second r) :font-size 11.0)
        (insert-text doc 0 (list 360.0 y) (third r) :font-size 11.0)
        (incf y 26.0)))
    (let ((tables (find-tables doc 0)))
      (check (= (length tables) 1) "find-tables detected 1 table")
      (when tables
        (let ((tbl (first tables)))
          (check (= (table-row-count tbl) 4) "Table has 4 rows")
          (check (= (table-col-count tbl) 3) "Table has 3 cols")
          (check (equal (table-header tbl) '("Implementation" "Standard" "Platform")) "Table header matches")
          (let ((md (table-to-markdown tbl)))
            (check (search "SBCL" md) "Markdown contains SBCL")
            (check (search "ANSI" md) "Markdown contains ANSI")))))))

(deftest test-markdown-html-and-rag ()
  (with-open-pdf (doc (new-pdf))
    (new-page doc)
    (insert-text doc 0 '(72.0 72.0) "Chapter 1: The Lisp Way" :font-size 20.0)
    (insert-text doc 0 '(72.0 120.0) "Lisp code is made of Lisp data structures." :font-size 12.0)
    (let ((md (to-markdown doc)))
      (check (search "Chapter 1: The Lisp Way" md) "to-markdown includes heading")
      (check (search "data structures" md) "to-markdown includes body text"))
    (let ((html (to-html doc)))
      (check (search "<p" html) "to-html includes HTML markup"))
    (let ((chunks (to-rag-chunks doc :max-chars 300)))
      (check (listp chunks) "to-rag-chunks returns list")
      (check (> (length chunks) 0) "to-rag-chunks returned at least 1 chunk")
      (check (getf (first chunks) :text) "RAG chunk has :text")
      (check (getf (first chunks) :bbox) "RAG chunk has :bbox"))))

(deftest test-render-and-svg ()
  (with-open-pdf (doc (new-pdf))
    (new-page doc :width 300.0 :height 300.0)
    (draw-rect doc 0 '(50.0 50.0 250.0 250.0)
               :stroke-color '(0.1 0.3 0.8)
               :fill-color '(0.9 0.95 1.0)
               :width 2.0)
    (insert-text doc 0 '(70.0 150.0) "Vector & Raster" :font-size 14.0)
    ;; Rasterization
    (let ((pix (render-page doc 0 :dpi 100.0)))
      (check (pixmap-p pix) "render-page returns a valid pixmap")
      (check (> (pixmap-width pix) 0) "Pixmap width > 0")
      (check (> (pixmap-height pix) 0) "Pixmap height > 0")
      (check (typep (pixmap-samples pix) '(vector (unsigned-byte 8))) "Pixmap samples is unsigned-byte 8 vector")
      (let ((png (pixmap-to-png pix)))
        (check (typep png '(vector (unsigned-byte 8))) "pixmap-to-png returns unsigned-byte 8 vector")
        (check (and (> (length png) 4)
                    (= (aref png 0) #x89)
                    (= (aref png 1) #x50)
                    (= (aref png 2) #x4E)
                    (= (aref png 3) #x47))
               "PNG magic signature matches \x89PNG")))
    ;; SVG export
    (let ((svg (page-to-svg doc 0)))
      (check (stringp svg) "page-to-svg returns string")
      (check (search "<svg" svg) "SVG string contains <svg tag"))))

(deftest test-navigation-toc-and-links ()
  (with-open-pdf (doc (new-pdf))
    (new-page doc)
    (new-page doc)
    ;; Outlines / TOC
    (let ((toc '((:level 1 :title "Introduction" :page 1)
                 (:level 2 :title "ANSI Standard" :page 2))))
      (set-document-toc doc toc)
      (let ((ret-toc (document-toc doc)))
        (check (= (length ret-toc) 2) "document-toc returned 2 entries")
        (check (string= (getf (first ret-toc) :title) "Introduction") "TOC 1 title matches")
        (check (string= (getf (second ret-toc) :title) "ANSI Standard") "TOC 2 title matches")))
    ;; Hyperlinks
    (insert-link doc 0 '(72.0 100.0 200.0 120.0) :uri "https://common-lisp.net")
    (insert-link doc 0 '(72.0 140.0 200.0 160.0) :dest-page 2)
    (let ((links (page-links doc 0)))
      (check (= (length links) 2) "page-links returned 2 links")
      (check (some (lambda (l) (equal (getf l :uri) "https://common-lisp.net")) links) "URI link verified")
      (check (some (lambda (l) (equal (getf l :page) 2)) links) "Destination page link verified"))
    ;; Delete link
    (delete-link doc 0 :rect '(72.0 100.0 200.0 120.0))
    (let ((updated (page-links doc 0)))
      (check (= (length updated) 1) "1 link remaining after delete-link"))))

(deftest test-annotations-redactions-and-forms ()
  (with-open-pdf (doc (new-pdf))
    (new-page doc)
    (insert-text doc 0 '(72.0 100.0) "Top Secret SecretKey-9999 Information" :font-size 14.0)
    ;; Highlight annotation
    (add-highlight-annotation doc 0 '(72.0 100.0 300.0 120.0) :text "Review this key")
    (let ((annots (page-annotations doc 0)))
      (check (> (length annots) 0) "page-annotations returned annotations")
      (check (some (lambda (a) (string-equal (getf a :kind) "highlight")) annots) "Highlight annot present"))
    ;; Redaction
    (add-redaction doc 0 '(70.0 80.0 380.0 115.0) :fill '(0.0 0.0 0.0))
    (apply-redactions doc 0)
    (let ((txt-after (extract-text doc 0)))
      (check (null (search "SecretKey-9999" txt-after)) "Redacted secret text is scrubbed from content stream"))
    ;; AcroForm Widgets
    (add-widget doc 0 '(72.0 200.0 250.0 230.0) "UserFeedback" "text" :value "Initial draft")
    (let ((widgets (page-widgets doc 0)))
      (check (= (length widgets) 1) "1 form widget found")
      (check (string= (getf (first widgets) :name) "UserFeedback") "Widget name is UserFeedback"))
    (set-widget-value doc "UserFeedback" "Final approval")
    (let ((updated-w (page-widgets doc 0)))
      (check (string= (getf (first updated-w) :value) "Final approval") "Widget value updated"))))

(deftest test-encryption-and-authentication ()
  (let ((enc-bytes
          (with-open-pdf (doc (new-pdf))
            (new-page doc)
            (insert-text doc 0 '(72.0 100.0) "Encrypted Vault 2026 Common Lisp" :font-size 16.0)
            (document-to-bytes doc
                               :deflate t
                               :encryption "rc4-128"
                               :user-password "lisp_user_pw"
                               :owner-password "lisp_owner_pw"))))
    (check (typep enc-bytes '(vector (unsigned-byte 8))) "Encrypted bytes produced")
    (with-open-pdf (doc enc-bytes)
      (check (document-encrypted-p doc) "Document is recognized as encrypted")
      (check (not (authenticate-document doc "wrong_pw")) "Wrong password fails authentication")
      (check (authenticate-document doc "lisp_user_pw") "User password succeeds authentication")
      (let ((txt (extract-text doc 0)))
        (check (search "Encrypted Vault 2026" txt) "Text successfully decrypted after authentication")))))

(deftest test-metadata-and-merge ()
  (let ((doc1 (new-pdf))
        (doc2 (new-pdf)))
    (new-page doc1)
    (insert-text doc1 0 '(72.0 72.0) "Doc 1 Content")
    (set-document-metadata doc1 :title "Document One" :author "Gwang-Jin Kim")
    (let ((meta (document-metadata doc1)))
      (check (string= (getf meta :title) "Document One") "Metadata title set")
      (check (string= (getf meta :author) "Gwang-Jin Kim") "Metadata author set"))
    (new-page doc2)
    (insert-text doc2 0 '(72.0 72.0) "Doc 2 Content")
    (let ((b1 (document-to-bytes doc1))
          (b2 (document-to-bytes doc2)))
      (close-pdf doc1)
      (close-pdf doc2)
      (let ((merged-bytes (merge-documents (list b1 b2))))
        (check (typep merged-bytes '(vector (unsigned-byte 8))) "merge-documents returns byte vector")
        (with-open-pdf (merged-doc merged-bytes)
          (check (= (page-count merged-doc) 2) "Merged document has 2 pages")
          (check (search "Doc 1 Content" (extract-text merged-doc 0)) "Page 0 has Doc 1")
          (check (search "Doc 2 Content" (extract-text merged-doc 1)) "Page 1 has Doc 2"))))))

(defun run-all-tests ()
  "Runs all test cases and reports results. Returns T if all tests passed, NIL otherwise."
  (setf *test-count* 0
        *failed-count* 0)
  (format t "~%****************************************~%")
  (format t "    Running pdfrune Common Lisp Tests     ~%")
  (format t "****************************************~%")
  (test-version)
  (test-document-creation-and-lifecycle)
  (test-words-blocks-search)
  (test-table-detection)
  (test-markdown-html-and-rag)
  (test-render-and-svg)
  (test-navigation-toc-and-links)
  (test-annotations-redactions-and-forms)
  (test-encryption-and-authentication)
  (test-metadata-and-merge)
  (format t "~%========================================~%")
  (format t "Summary: ~D assertions, ~D failures~%" *test-count* *failed-count*)
  (format t "========================================~%")
  (if (zerop *failed-count*)
      (progn
        (format t "ALL COMMON LISP TESTS PASSED!~%~%")
        t)
      (progn
        (format *error-output* "~D TESTS FAILED!~%~%" *failed-count*)
        (error "~D tests failed in pdfrune-test" *failed-count*))))
